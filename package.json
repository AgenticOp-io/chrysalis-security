{
  "name": "chrysalis-security",
  "version": "0.1.0",
  "private": true,
  "description": "Helix — Chrysalis security fork. Behavioral DNA firewall.",
  "type": "module",
  "scripts": {
    "demo:api": "node fixtures/demo-api/server.mjs",
    "proxy": "node packages/helix-proxy/server.mjs",
    "helix": "node packages/helix-cli/bin/helix.mjs",
    "learn:demo": "node packages/helix-cli/bin/helix.mjs learn --in fixtures/sample-observations.ndjson --out certificates/demo-draft.json",
    "diff:demo": "node packages/helix-cli/bin/helix.mjs diff --a certificates/demo-certified.json --b certificates/demo-draft-backdoor.json",
    "smoke": "node scripts/smoke.mjs",
    "host-smoke": "node scripts/host-smoke.mjs",
    "static-smoke": "node scripts/static-smoke.mjs",
    "dna-core-smoke": "node scripts/dna-core-smoke.mjs",
    "schema-drift-smoke": "node scripts/schema-drift-smoke.mjs",
    "gce-smoke": "node scripts/smoke.mjs",
    "nft-smoke": "bash scripts/gce-nft-smoke.sh",
    "agent": "node packages/helix-agent/bin/helix-agent.mjs",
    "test": "node scripts/dna-core-smoke.mjs && node scripts/smoke.mjs && node scripts/host-smoke.mjs && node scripts/static-smoke.mjs && node scripts/schema-drift-smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}

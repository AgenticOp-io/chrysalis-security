# Copy to %ProgramData%\Helix\helix-agent.env (install.ps1 does this).
# Mode A: Helix owns the public listen port; the app binds localhost only (D4).

LISTEN_HOST=0.0.0.0
LISTEN_PORT=4080
APP_UPSTREAM=http://127.0.0.1:8080
MODE=learn
DNA=C:\ProgramData\Helix\app.dna.json
OBSERVE=C:\ProgramData\Helix\observations.ndjson
SHADOW_LOG=C:\ProgramData\Helix\shadow.ndjson
SIEM_LOG=C:\ProgramData\Helix\siem.ndjson
HELIX_MAX_BODY_BYTES=1048576
HELIX_ROOT_PANEL=1
# HELIX_SENSITIVITY=C:\ProgramData\Helix\sensitivity.json
# HELIX_DNA_KEY=...
# HELIX_DNA_REQUIRE=1

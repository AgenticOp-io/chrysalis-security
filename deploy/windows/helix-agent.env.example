# Helix for Windows — Mode A (copy via install / Protect wizard).
# Front door = LISTEN_PORT. App = APP_UPSTREAM (localhost only).

LISTEN_HOST=0.0.0.0
LISTEN_PORT=4080
APP_UPSTREAM=http://127.0.0.1:4090
MODE=learn
DNA=C:\ProgramData\Helix\app.dna.json
OBSERVE=C:\ProgramData\Helix\observations.ndjson
SHADOW_LOG=C:\ProgramData\Helix\shadow.ndjson
SIEM_LOG=C:\ProgramData\Helix\siem.ndjson
HELIX_MAX_BODY_BYTES=1048576
HELIX_ROOT_PANEL=1
# Start bundled demo API if nothing is on APP_UPSTREAM yet:
HELIX_START_DEMO=1
# After N learned requests, auto Lock DNA + watch (0 = off):
HELIX_AUTO_SEAL_AFTER=12
# HELIX_SENSITIVITY=C:\ProgramData\Helix\sensitivity.json
# HELIX_DNA_KEY=...
# HELIX_DNA_REQUIRE=1

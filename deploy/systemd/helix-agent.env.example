# Copy to /etc/helix/helix-agent.env
LISTEN_HOST=0.0.0.0
LISTEN_PORT=4080
APP_UPSTREAM=http://127.0.0.1:8080
MODE=learn
DNA=/var/lib/helix/app.dna.json
OBSERVE=/var/lib/helix/observations.ndjson
SHADOW_LOG=/var/lib/helix/shadow.ndjson
SIEM_LOG=/var/lib/helix/siem.ndjson
HELIX_MAX_BODY_BYTES=1048576
# HELIX_DNA_KEY=...
# HELIX_DNA_REQUIRE=1
